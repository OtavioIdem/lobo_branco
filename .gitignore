*.apk
*.aab
*.unitypackage
*.app

# Crashes
sysinfo.txt
crashlytics-build.properties

# OS
.DS_Store
Thumbs.db
desktop.ini

# Nunca ignorar .meta: eles carregam as referencias entre assets
!*.meta

# Scratch local
/scratch/

# Logs de batchmode do Unity
unity/*.log
unity/test-results-*.xml
